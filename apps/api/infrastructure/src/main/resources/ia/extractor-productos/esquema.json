    "esta_agotado",
    "titulo",
    "linea",
    "tipo",
    "precio_proveedor_cop",
    "tallas",
    "cantidad_tonos",
    "tonos_nombrados",
    "material",
    "caracteristicas",
    "confianza",
    "notas"
  ],
