{
  "type": "object",
  "additionalProperties": false,
  "required": ["album_de_disenos", "fotos"],
  "properties": {
    "album_de_disenos": { "type": "boolean" },
    "fotos": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "foto",
          "codigos",
          "pie",
          "colores",
          "diseno",
          "marcas",
          "tallas",
          "calzado"
        ],
        "properties": {
          "foto": { "type": "integer" },
          "codigos": { "type": "array", "items": { "type": "string" } },
          "pie": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["sku", "fecha", "tallas"],
              "properties": {
                "sku": { "type": "string" },
                "fecha": { "type": ["string", "null"] },
                "tallas": { "type": "array", "items": { "type": "string" } }
              }
            }
          },
          "colores": { "type": "array", "items": { "type": "string" } },
          "diseno": { "type": ["string", "null"] },
          "marcas": { "type": "array", "items": { "type": "string" } },
          "tallas": { "type": "array", "items": { "type": "string" } },
          "calzado": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "tipo",
              "marca",
              "modelo",
              "modelo_seguro",
              "genero",
              "producto_solo",
              "mismo_tenis_que"
            ],
            "properties": {
              "tipo": {
                "type": "string",
                "enum": ["no_es_calzado", "tenis", "chancla", "sandalia", "zueco", "bota", "otro"]
              },
              "marca": { "type": "string" },
              "modelo": { "type": "string" },
              "modelo_seguro": { "type": "boolean" },
              "genero": { "type": "string", "enum": ["dama", "caballero", "unisex", "no_se_sabe"] },
              "producto_solo": { "type": "boolean" },
              "mismo_tenis_que": { "type": "integer" }
            }
          }
        }
      }
    }
  }
}
