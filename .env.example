# Copiar a .env.local (git-ignorado) y ajustar. Valores falsos, de desarrollo
# local únicamente. En producción viven en Secret Manager. Ver docs/07-infra-gcp.md.

APP_URL_PUBLICA=http://localhost:4200
API_URL_PUBLICA=http://localhost:8080/api/v1

# Postgres del docker-compose.yml local
DB_HOST=localhost
DB_PUERTO=5432
DB_NOMBRE=tecnosport
DB_USUARIO=tecnosport
DB_CLAVE=tecnosport

# Wompi: llaves de prueba de la cuenta sandbox, nunca las de producción aquí
WOMPI_LLAVE_PUBLICA=pub_test_ejemplo
WOMPI_SECRETO_EVENTOS=ejemplo_secreto_eventos
WOMPI_SECRETO_INTEGRIDAD=ejemplo_secreto_integridad
WOMPI_AMBIENTE=pruebas
# Los metodos que la cuenta de Wompi tiene activados, no los que el codigo sabe procesar.
# ADDI no esta: su activacion exige el sitio ya en linea (decision del 14 de septiembre de 2026).
# Cuando Wompi lo active, se agrega aqui Y se devuelve la frase de los terminos.
WOMPI_METODOS_HABILITADOS=TARJETA,PSE,NEQUI,BANCOLOMBIA

# Primer usuario ADMIN. SembradorAdmin lo crea al arrancar SOLO si no existe ya uno
# con ese correo, y nunca actualiza uno existente: cambiar ADMIN_CLAVE después no
# rota la clave del admin ya creado (pendiente anotado en docs/09-plan-de-arranque.md).
# Para cambiarla hoy hay que borrar la fila de `usuario` y volver a arrancar.
ADMIN_CORREO=admin@tecnosport.co
ADMIN_CLAVE=cambiar_en_local

# docs/08-seguridad-legal.md: acceso de 15 minutos, refresco de 30 días
JWT_SECRETO=ejemplo_cambiar_en_local
JWT_MINUTOS_ACCESO=15
JWT_DIAS_REFRESCO=30

# Fecha de vigencia del texto de /legales/privacidad, que se estampa en cada constancia de
# autorización (Ley 1581 de 2012). Va acoplada al texto, que vive en los JSON de Transloco de este
# mismo repositorio: cambiar el texto y cambiar esta fecha son el mismo commit. Existe como
# variable para poder corregirla sin redesplegar, no para tener que fijarla en cada entorno.
POLITICA_DATOS_VERSION=2026-09-18

# ¿El negocio es responsable del impuesto sobre las ventas? Hoy NO (parágrafo 3 del art. 437 del
# Estatuto Tributario), y por eso ninguna variante puede declarar una tasa distinta de cero: el
# literal a del art. 1.3.1.15.2 del Decreto 1625 de 2016 prohíbe a un no responsable adicionar al
# precio suma alguna por concepto de IVA, y quien lo hace queda obligado a cumplir íntegramente el
# régimen de los responsables. Se pierde la calidad al cruzar los topes del parágrafo 3; ese día
# esto pasa a true, el texto publicado cambia con ella y `npm run datos-negocio` lo comprueba.
NEGOCIO_RESPONSABLE_IVA=false

# Cada cuánto sale la tanda de comprobantes de compra, y con cuánto retraso arranca tras un
# despliegue. Minutos, y pocos: el comprobante llega mientras quien compró todavía está pendiente de
# su pedido. El retraso inicial tiene que ser menor que el intervalo, o cada despliegue reinicia la
# cuenta y la tarea puede no correr nunca.
PEDIDO_COMPROBANTES_INTERVALO_MINUTOS=2
PEDIDO_COMPROBANTES_RETRASO_INICIAL_MINUTOS=1

# docs/02-modelo-datos.md: "el carrito vive 30 días". Se cuentan desde la última actividad, no
# desde la creación: un carrito usado cada semana lleva meses creado y no es basura. El intervalo
# de la purga va en horas porque no es urgente.
CARRITO_DIAS_RETENCION=30
CARRITO_PURGA_INTERVALO_MINUTOS=360

# Ningún doc especifica esta duración (docs/08 solo da la de recuperación, 30 min) —
# parámetro técnico, no un dato de negocio.
VERIFICACION_CORREO_HORAS_VENCIMIENTO=24

# docs/08-seguridad-legal.md: "token de un solo uso, válido 30 minutos".
RECUPERACION_CLAVE_MINUTOS_VENCIMIENTO=30

# docs/08-seguridad-legal.md pide límite de intentos por IP y por cuenta, sin dar números —
# dato de seguridad, no de negocio. "auth" agrupa sesión/registro/recuperación; "pedidos" es
# más generoso porque reintentar una compra es normal.
LIMITE_AUTH_IP_MAXIMO=15
LIMITE_AUTH_IP_MINUTOS=15
LIMITE_AUTH_CUENTA_MAXIMO=5
LIMITE_AUTH_CUENTA_MINUTOS=15
LIMITE_PEDIDOS_IP_MAXIMO=30
LIMITE_PEDIDOS_IP_MINUTOS=60
LIMITE_PEDIDOS_CUENTA_MAXIMO=15
LIMITE_PEDIDOS_CUENTA_MINUTOS=60

# Bucket real de Cloud Storage en tier gratuito (docs/07-infra-gcp.md: dev usa
# solo servicios GCP sin costo). GOOGLE_APPLICATION_CREDENTIALS es la variable
# estándar que el SDK de Google Cloud lee solo — nunca se referencia en código
# propio — y solo aplica en local: en Cloud Run (producción) no se define, la
# cuenta de servicio adjunta al servicio se usa automáticamente, sin llave.
# Garantia legal. Doce meses para producto nuevo, que es el termino legal. La lista
# de categorias sin termino conocido responde "no se sabe" en vez de caer al termino
# general, y hoy va vacia: los celulares salieron de ella porque su termino lo fija
# la ley igual que el de los demas productos nuevos. Un productor que anuncie un
# termino mayor va en tecnosport.garantia.meses-por-categoria.
# Ver docs/08-seguridad-legal.md.
GARANTIA_MESES_POR_DEFECTO=12
GARANTIA_CATEGORIAS_SIN_TERMINO=

# Plazos de respuesta a peticiones, quejas y reclamos, en dias habiles.
# Ley 1581 de 2012 para los de datos personales; el del consumidor es el que
# prometen los terminos publicados. Ver docs/08-seguridad-legal.md.
ATENCION_DIAS_CONSULTA_DATOS=10
ATENCION_DIAS_PRORROGA_CONSULTA_DATOS=5
ATENCION_DIAS_RECLAMO_DATOS=15
ATENCION_DIAS_PRORROGA_RECLAMO_DATOS=8
ATENCION_DIAS_CONSUMIDOR=15

GCS_BUCKET_IMAGENES=tecnosport-dev-imagenes
GCS_URL_PUBLICA=https://storage.googleapis.com/tecnosport-dev-imagenes
# Parámetro técnico (cuánto dura la ventana para subir), no un dato de negocio
# — mismo criterio que VERIFICACION_CORREO_HORAS_VENCIMIENTO más arriba.
GCS_MINUTOS_URL_FIRMADA=15
GOOGLE_APPLICATION_CREDENTIALS=C:/Users/tu-usuario/.gcp/tecnosport-dev-imagenes.json

# Mailpit del docker-compose.yml local. SMTP_PUERTO: Mailpit usa 1025, no el
# 587/465 típico de un SMTP real — se agregó junto a SMTP_HOST igual que
# DB_PUERTO ya existe junto a DB_HOST. SMTP_AUTH en false: Mailpit no exige
# autenticación: en producción, con un SMTP real y SMTP_USUARIO/SMTP_CLAVE
# reales, se pone en true.
# El ambiente dev desplegado no usa esto: manda por Resend, con remitente en
# dev.tecnosport.co (docs/07-infra-gcp.md, seccion "Correo saliente"). Aqui
# abajo queda Mailpit, que es lo que corresponde en local: no sale nada.
SMTP_HOST=localhost
SMTP_PUERTO=1025
SMTP_AUTH=false
SMTP_USUARIO=
SMTP_CLAVE=
CORREO_REMITENTE=no-responder@tecnosport.co

# La bandeja de salida de correos (ADR-0045). Un caso de uso no manda un correo: escribe una fila,
# con su misma transacción, y esta tarea la manda después con reintentos. Si la transacción
# revierte, el correo no existió nunca.
#
# DIAS_RETENCION no es un ajuste de rendimiento: el cuerpo de un correo lleva el nombre de quien
# compró, su pedido y a veces su dirección, así que es dato personal en reposo
# (docs/08-seguridad-legal.md). El tope de intentos y su espaciado NO se configuran: son una
# constante del mecanismo, en DrenarBandejaDeSalida.
CORREO_BANDEJA_INTERVALO_MINUTOS=1
CORREO_BANDEJA_RETRASO_INICIAL_MINUTOS=0
CORREO_BANDEJA_DIAS_RETENCION=30
CORREO_BANDEJA_TAMANO_LOTE=100

# Cotización de envío con Skydropx (ADR-0021). El mapeo de campos se confirmó contra la cuenta
# real el 11 de septiembre de 2026; lo verificado está en docs/13-skydropx-capacidades.md.
#
# El host de pruebas es sb-pro.skydropx.com, comprobado: es el único de los tres candidatos que
# autentica con las credenciales de sandbox (api-pro y pro devuelven invalid_client).
# En producción el panel indica api-pro.skydropx.com, y eso no se ha podido comprobar todavía
# porque exige credenciales de producción. TODO: confirmarlo con la primera cotización real.
SKYDROPX_URL_BASE=https://sb-pro.skydropx.com
SKYDROPX_CLIENT_ID=
SKYDROPX_CLIENT_SECRET=
# Parámetros técnicos del sondeo, no datos de negocio: la cotización es asíncrona y hay que
# decidir cuánto se espera antes de darla por fallida.
SKYDROPX_COTIZACION_TIMEOUT_SEGUNDOS=10
SKYDROPX_COTIZACION_INTENTOS=8
# El mínimo asegurable por bulto que exige la plataforma (docs/13 §6.4): por debajo responde 422 y
# tumba la cotización entera. Los bultos que no llegan se elevan hasta aquí (ADR-0035).
SKYDROPX_VALOR_DECLARADO_MINIMO=10000
# El otro extremo del rango (docs/13 §6.13). Por encima no se recorta: ese artículo no va a
# domicilio y el checkout lo dice (ADR-0036).
SKYDROPX_VALOR_DECLARADO_MAXIMO=5000000
# Dónde manda Skydropx la firma del webhook. Variable porque el nombre se elige en el panel.
SKYDROPX_CABECERA_FIRMA=authorization
# El secreto con el que Skydropx firma el evento, generado en el panel (Conexiones > Webhooks).
# Vacío aquí a propósito: mientras no exista, el verificador rechaza todos los eventos.
SKYDROPX_SECRETO_WEBHOOK=
# Límite de cotizaciones por IP: el único endpoint público que gasta cuota de un proveedor pago.
LIMITE_COTIZACION_IP_MAXIMO=60
LIMITE_COTIZACION_IP_MINUTOS=30
# La conciliación de envíos: cada cuánto corre y desde cuándo se considera callado un envío.
# El webhook suele llegar antes; esto es la red por debajo, para los que se pierden.
SKYDROPX_SEGUIMIENTO_INTERVALO_MINUTOS=360
SKYDROPX_SEGUIMIENTO_ANTIGUEDAD_MINIMA_HORAS=12
# Techo del lote de cada corrida: cada envío revisado es una llamada al proveedor.
SKYDROPX_SEGUIMIENTO_MAXIMO_POR_CORRIDA=25
# La tarea que cierra las emisiones corre mucho más seguido que el seguimiento: espera una respuesta
# que llega en segundos o minutos, con un pedido pagado esperándola. Solo hay algo que revisar
# cuando alguien acaba de pulsar el botón del panel.
SKYDROPX_EMISION_INTERVALO_SEGUNDOS=60

# La dirección de despacho del negocio: origen de cada cotización y, cuando exista, de cada
# recolección. Es la misma del punto de recogida, ya decidida. El teléfono es el que publica el
# pie del sitio (npm run datos-negocio vigila que no se separen).
ORIGEN_NOMBRE=TecnoSport
ORIGEN_TELEFONO=+573138816711
ORIGEN_DIRECCION=Cra. 26C # 38B-31, apto. 401, La Milagrosa
# Los nombres, obligatorios para Skydropx aparte del código DANE. Grafías de DIVIPOLA.
ORIGEN_DEPARTAMENTO=Antioquia
ORIGEN_CIUDAD=Medellín
# Lo que Skydropx recibe como "postal_code": su catálogo es el DANE, no el postal real.
ORIGEN_CIUDAD_DANE=05001
# Opcional, y hoy no viaja en la cotización: en Colombia no se usa de forma fiable y muchas
# transportadoras lo ignoran. Queda para la guía y la recolección.
ORIGEN_CODIGO_POSTAL=
# Tampoco viaja en la cotización: la guía exige email en las dos direcciones. El correo público
# del negocio, no el remitente transaccional: lo que escriba la transportadora tiene que leerlo
# alguien.
ORIGEN_CORREO=contacto@tecnosport.co
# El barrio, y de él depende que la recolección se pueda programar: viaja como area_level3 en la
# cotización y el envío lo hereda de ahí. Sin él, POST /pickups responde "Shipper address2 not
# valid" y GET /pickups/coverage un 422 con el mensaje vacío. Ya estaba dentro de ORIGEN_DIRECCION
# como texto; la plataforma lo quiere en su propio campo (docs/13-skydropx-capacidades.md §6.10).
ORIGEN_BARRIO=La Milagrosa
# Obligatoria en la dirección de origen al emitir, y se imprime en la guía: es lo que lee el
# mensajero que viene a recoger.
ORIGEN_REFERENCIA=Apartamento 401
CONTRAENTREGA_HABILITADA=false
# El rango que recauda la transportadora, no una preferencia del negocio: lo que reporta la ayuda
# publica de Skydropx (docs/12-legales-de-envio.md, seccion 4). Se comparan contra el TOTAL del
# pedido, con el flete dentro, porque es lo que se cobra en la puerta.
#
# Pendiente de confirmar en el contrato, y el marcador de docs/11-pagos-y-envios.md sigue abierto:
# estas dos cifras salen de la ayuda publica, no de un contrato firmado. Si el contrato trae un
# tope menor, las guias se rechazan al emitirlas con el pedido ya confirmado.
CONTRAENTREGA_MONTO_MINIMO=2000
CONTRAENTREGA_MONTO_MAXIMO=2000000
# Vacia a proposito. La regla del negocio es por PRECIO y no por linea —lo tecnologico por encima
# de COP 2.000.000 no va contra entrega, y un celular por debajo si puede— y esa regla la
# implementa CONTRAENTREGA_MONTO_MAXIMO, que se compara contra el total del pedido. Poner
# TECNOLOGIA aqui bloquearia tambien los celulares de 1.3M y 1.5M, que el negocio si quiere
# despachar. Los valores validos son los tres de LineaCatalogo: ROPA_Y_CALZADO, BOLSOS, TECNOLOGIA
# —CELULARES ya no es uno de ellos y no arranca—.
CONTRAENTREGA_CATEGORIAS_EXCLUIDAS=
# docs/11-pagos-y-envios.md: reserva de transferencia manual es de 24 horas
TRANSFERENCIA_HORAS_VENCIMIENTO=24

# Cada cuánto se revisa si algún pedido pasó de los 30 días calendario para entregarse (Ley 1480 de
# 2011, art. 18). Parámetro técnico, no un dato de negocio: el plazo de 30 días vive en
# PlazoDeEntrega, y lo que se hace al vencer —avisar, nunca cancelar— está en ADR-0028.
# El retraso inicial tiene que ser menor que el intervalo: si lo iguala, cada despliegue reinicia la
# cuenta y con despliegues diarios la tarea no corre nunca.
PLAZO_ENTREGA_VIGILANCIA_INTERVALO_MINUTOS=720
PLAZO_ENTREGA_VIGILANCIA_RETRASO_INICIAL_MINUTOS=5

# docs/11-pagos-y-envios.md contrasta la reserva normal con la de 30 minutos
MINUTOS_RESERVA_INVENTARIO=30
# TODO: dato de negocio pendiente de decidir (tasa de IVA vigente)
IVA_TASA_PREDETERMINADA=
# TODO: dato de negocio pendiente de decidir (docs/10-captura-360.md)
ROTACION_FOTOGRAMAS_PREDETERMINADO=
# TODO: dato de negocio pendiente de decidir (docs/10-captura-360.md)
ROTACION_TOLERANCIA_GRADOS=
