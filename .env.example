# Copiar a .env.local (git-ignorado) y ajustar. Valores falsos, de desarrollo
# local únicamente. En producción viven en Secret Manager. Ver docs/07-infra-gcp.md.

APP_URL_PUBLICA=http://localhost:4200
API_URL_PUBLICA=http://localhost:8080/api/v1

# Postgres del docker-compose.yml local
DB_HOST=localhost
DB_PUERTO=5432
DB_NOMBRE=tecnosport
DB_USUARIO=tecnosport
DB_CLAVE=tecnosport

# Wompi: llaves de prueba de la cuenta sandbox, nunca las de producción aquí
WOMPI_LLAVE_PUBLICA=pub_test_ejemplo
WOMPI_LLAVE_PRIVADA=prv_test_ejemplo
WOMPI_SECRETO_EVENTOS=ejemplo_secreto_eventos
WOMPI_SECRETO_INTEGRIDAD=ejemplo_secreto_integridad
WOMPI_AMBIENTE=pruebas

# docs/08-seguridad-legal.md: acceso de 15 minutos, refresco de 30 días
JWT_SECRETO=ejemplo_cambiar_en_local
JWT_MINUTOS_ACCESO=15
JWT_DIAS_REFRESCO=30

GCS_BUCKET_IMAGENES=tecnosport-imagenes-local
GCS_URL_PUBLICA=http://localhost:9000/tecnosport-imagenes-local
# TODO: dato de negocio pendiente de decidir (docs/08 solo dice "vencimiento corto")
GCS_MINUTOS_URL_FIRMADA=

# Mailpit del docker-compose.yml local
SMTP_HOST=localhost
SMTP_USUARIO=
SMTP_CLAVE=
CORREO_REMITENTE=no-responder@tecnosport.co

ENVIO_PROVEEDOR=tarifas-propias
ENVIO_API_URL=
ENVIO_API_LLAVE=
CONTRAENTREGA_HABILITADA=false
# TODO: dato de negocio pendiente de decidir (docs/11-pagos-y-envios.md)
CONTRAENTREGA_MONTO_MAXIMO=
# TODO: dato de negocio pendiente de decidir (docs/11-pagos-y-envios.md)
CONTRAENTREGA_CATEGORIAS_EXCLUIDAS=
# docs/11-pagos-y-envios.md: reserva de transferencia manual es de 24 horas
TRANSFERENCIA_HORAS_VENCIMIENTO=24

# docs/11-pagos-y-envios.md contrasta la reserva normal con la de 30 minutos
MINUTOS_RESERVA_INVENTARIO=30
# TODO: dato de negocio pendiente de decidir (tasa de IVA vigente)
IVA_TASA_PREDETERMINADA=
# TODO: dato de negocio pendiente de decidir (docs/10-captura-360.md)
ROTACION_FOTOGRAMAS_PREDETERMINADO=
# TODO: dato de negocio pendiente de decidir (docs/10-captura-360.md)
ROTACION_TOLERANCIA_GRADOS=
